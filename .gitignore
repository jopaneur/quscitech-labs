###############################################################
#  QuSciTech-Labs Standard .gitignore
#  (© 2025 Dr. Joe Wilson — QuSciTech Press)
#  Purpose: Protect internal data, enable public workflows
###############################################################

# ============================================================
# 🧩 1. Core Git and System Hygiene
# ============================================================

# macOS and Windows clutter
.DS_Store
Thumbs.db
desktop.ini

# Temporary or backup files
*.bak
*.tmp
*.log
*.swp
*.lock

# Python cache and artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg/
dist/
build/
.env
venv/
.venv/
.cache/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# ============================================================
# 🔒 2. Private/Internal Folders
# ============================================================

# System-level internal docs (verification procedures, admin notes)
system/

# Future private content (tokens, partner credentials)
private/

# Local-only automation and draft directories
local/
drafts/
backups/

# ============================================================
# 📚 3. Public Documentation and Deployment (Keep Visible)
# ============================================================
!.github/
!.github/workflows/
!.github/ISSUE_TEMPLATE/
!docs/
!helpers/
!Beginner_Labs/
!Intermediate_Labs/
!Advanced_Labs/
!LICENSE
!README.md
!Labs_MASTER_README.md

# ============================================================
# ⚙️ 4. OS/IDE Metadata (Auto-generated)
# ============================================================
.vscode/
.idea/
*.iml
*.suo
*.user
*.sln.docstates

# ============================================================
# 🧪 5. Large Assets (Optional Local Exclusion)
# ============================================================
# Ignore raw experiment data >100MB (handled in private repo)
assets/raw/
data/
datasets/

###############################################################
#  ✅ Notes
#  Keep this .gitignore version-controlled for consistency.
#  Confirm hidden files with: git status
#  Visible files should only include those necessary for
#  public documentation, labs, and GitHub Actions.
###############################################################

# ============================
# 🧠 QuSciTech Private Materials
# ============================
# Prevent internal admin / ops documents from being committed

# Private operational guides and checklists
QAIS_*_Internal_Ops.docx
QAIS_*_TA_Checklist.docx

# Any similar private operational docs
/private/ops/
/private/admin/
/private/confidential/
/private/**/*.docx
/private/**/*.pdf
/private/**/*.md

# Ignore all hidden operational docs unless explicitly needed
**/ops/**/*
**/admin/**/*
